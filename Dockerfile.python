ARG DEPENDENCY_DOCKER_REGISTRY=docker.io
FROM ${DEPENDENCY_DOCKER_REGISTRY}/library/python:3.12-slim-bookworm AS development

ARG TARGETARCH
ARG DEPENDENCY_GITHUB_RAW_URL=https://github.com
ENV DEPENDENCY_GITHUB_RAW_URL=${DEPENDENCY_GITHUB_RAW_URL}
COPY dependency-download-mirrors.generated.env /etc/servicegen/dependency-download-mirrors.generated.env
COPY dependency-download-mirrors.env /etc/servicegen/dependency-download-mirrors.env
COPY dependency-download-env.generated.sh /usr/local/bin/servicegen-download-env
SHELL ["/usr/local/bin/servicegen-download-env", "/bin/sh", "-c"]
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST=
ARG UV_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/workspace/.venv/bin:$PATH \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    UV_INDEX_URL=${UV_INDEX_URL}

WORKDIR /workspace

RUN apt-get update && \
    apt-get install --yes --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir uv==0.12.7

COPY . .
RUN for service in analyticsservice automationservice inventoryservice orderservice ; do \
      LOCAL_DEPENDENCIES_DIR=/workspace \
        "/workspace/${service}/scripts/fetch-dependencies.generated.sh"; \
    done
COPY --from=pyservicelib-source . /tmp/pyservicelib-source
RUN set -eu; \
    source_dir=/tmp/pyservicelib-source; \
    archive=$(find "$source_dir" -mindepth 1 -maxdepth 1 -type f \( -name context -o -name '*.tar' -o -name '*.tar.gz' -o -name '*.tgz' -o -name '*.tar.xz' \) -print -quit); \
    if [ -n "$archive" ]; then \
      mkdir -p /tmp/pyservicelib-archive; \
      tar -xf "$archive" -C /tmp/pyservicelib-archive; \
      source_dir=/tmp/pyservicelib-archive; \
    fi; \
    manifest="$source_dir/pyproject.toml"; \
    if [ ! -f "$manifest" ]; then manifest=$(find "$source_dir" -mindepth 2 -maxdepth 2 -type f -name pyproject.toml -print -quit); fi; \
    if [ -z "$manifest" ]; then echo "pyservicelib source context has no pyproject.toml" >&2; exit 1; fi; \
    source_dir=${manifest%/pyproject.toml}; \
    if [ -z "$source_dir" ] || [ "$source_dir" = "/" ]; then echo "unsafe pyservicelib source directory" >&2; exit 1; fi; \
    mkdir -p /workspace/.pyservicelib; \
    cp -a "$source_dir/." /workspace/.pyservicelib/; \
    rm -rf /tmp/pyservicelib-source

RUN --mount=type=cache,id=servicegen-python-uv-${TARGETARCH},target=/root/.cache/uv,sharing=locked \
    uv sync --all-packages --all-extras && \
    uv pip install --python /workspace/.venv/bin/python debugpy==1.8.17 && \
    ./scripts/python/generate.generated.sh
FROM development AS runtime-builder-analyticsservice

RUN uv sync --package analytics_service --no-dev --no-editable --no-cache
FROM development AS runtime-builder-automationservice

RUN uv sync --package automation_service --no-dev --no-editable --no-cache
FROM development AS runtime-builder-inventoryservice

RUN uv sync --package inventory_service --no-dev --no-editable --no-cache
FROM development AS runtime-builder-orderservice

RUN uv sync --package order_service --no-dev --no-editable --no-cache

FROM ${DEPENDENCY_DOCKER_REGISTRY}/library/python:3.12-slim-bookworm AS runtime-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/workspace/.venv/bin:$PATH

WORKDIR /workspace

FROM runtime-base AS runtime-analyticsservice
COPY --from=runtime-builder-analyticsservice /workspace/.venv /workspace/.venv
COPY --from=runtime-builder-analyticsservice /workspace/analyticsservice/config /workspace/config
ENTRYPOINT ["python", "-m", "analytics_service.main"]

FROM runtime-base AS runtime-automationservice
COPY --from=runtime-builder-automationservice /workspace/.venv /workspace/.venv
COPY --from=runtime-builder-automationservice /workspace/automationservice/config /workspace/config
ENTRYPOINT ["python", "-m", "automation_service.main"]

FROM runtime-base AS runtime-inventoryservice
COPY --from=runtime-builder-inventoryservice /workspace/.venv /workspace/.venv
COPY --from=runtime-builder-inventoryservice /workspace/inventoryservice/config /workspace/config
ENTRYPOINT ["python", "-m", "inventory_service.main"]

FROM runtime-base AS runtime-orderservice
COPY --from=runtime-builder-orderservice /workspace/.venv /workspace/.venv
COPY --from=runtime-builder-orderservice /workspace/orderservice/config /workspace/config
ENTRYPOINT ["python", "-m", "order_service.main"]